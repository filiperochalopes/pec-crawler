# App
TZ=America/Bahia
RUN_AT=07:00

# Postgres externo
POSTGRES_HOST=seu.host.postgres.com
POSTGRES_PORT=5432
POSTGRES_DB=pec
POSTGRES_USER=pec
POSTGRES_PASSWORD=coloque_sua_senha_aqui

# Azure OpenAI (opcional; necessário para gerar os resumos)
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/
AZURE_OPENAI_API_KEY=sua-chave
AZURE_OPENAI_DEPLOYMENT=gpt-4o-2024-05-13
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# (opcional) Se o provedor exigir TLS, depois ajusto para passar SSL via código.
# Por ora, mantenha sem SSL ou com túnel/seguro na rede.
